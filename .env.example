# ---------- Сайт ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Длинная случайная строка (подпись cookie входа). Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ---------- База данных (Supabase → Project Settings → Database → Connection string → Transaction pooler) ----------
# Если оставить пустым — локально используется встроенная dev-база в папке .data (только для разработки)
DATABASE_URL=

# ---------- Telegram ----------
# Бот создаётся в @BotFather; для виджета входа выполнить /setdomain и указать ваш домен
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Любая длинная случайная строка — защита вебхука бота
TELEGRAM_WEBHOOK_SECRET=
# Ваш Telegram ID (узнать у @userinfobot); через запятую, если админов несколько
ADMIN_TELEGRAM_IDS=

# ---------- Оплата (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Cron (вопрос дня). Vercel сам подставит этот секрет в заголовок ----------
CRON_SECRET=

# ---------- Правила доступа ----------
# Сколько первых тестов бесплатно (0 — всё платно)
FREE_TESTS=1
# Показывать пользователям вопросы со статусом прав "unverified". ТОЛЬКО для локальной разработки!
SERVE_UNVERIFIED_QUESTIONS=false

# ---------- Только для разработки ----------
# Открыть все 90 тестов без прохождения по порядку (для просмотра вопросов). На боевом сайте не работает
UNLOCK_ALL_TESTS=false
# Вход без Telegram (кнопка «Войти как разработчик» на /login). НИКОГДА не включать на боевом сайте
ENABLE_DEV_LOGIN=false

# ---------- Картинки вопросов в Supabase Storage (необязательно) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-images
